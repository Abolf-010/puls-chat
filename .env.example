# Copy to ".env" and fill in real values. Never commit .env to git.

# ── HTTP ──────────────────────────────────────────────
# On Windows avoid PORT=80 unless running as administrator
PORT=3000

# ── MongoDB ───────────────────────────────────────────
# Local:
MONGODB_URI=mongodb://127.0.0.1:27017/chat-app
# Atlas example:
# MONGODB_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/chat-app

# ── JWT ───────────────────────────────────────────────
# Use long random strings in any shared or production deploy
JWT_SECRET=change-me-access-secret-min-32-chars-xxxxxx
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-xxxx
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Redis ─────────────────────────────────────────────
# Used for presence / realtime helpers
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_PASSWORD=

# ── Web Push (optional) ───────────────────────────────
# Generate a matching pair (one line each, no quotes):
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ── Notes ─────────────────────────────────────────────
# - Keep JWT secrets and VAPID private key private
# - After changing JWT secrets, all users must log in again
# - VAPID public key must match what the frontend / service worker expects
